# FastAPI Service Dockerfile
FROM python:3.11-slim as base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml ./
RUN pip install --upgrade pip && \
    pip install "pydantic>=2.7.0" "pydantic-settings>=2.2.0" "fastapi>=0.111.0" "uvicorn>=0.30.0" \
                "structlog>=24.1.0" "numpy>=1.26.0" "pandas>=2.2.0" "scipy>=1.13.0" \
                "scikit-learn>=1.4.0" "lightgbm>=4.3.0" "pulp>=2.8.0" "duckdb>=0.10.0" \
                "pyarrow>=15.0.0" "pyyaml>=6.0.1" "requests>=2.31.0"

COPY services/ ./services/
COPY pipelines/ ./pipelines/
COPY data/ ./data/

ENV PYTHONPATH="/app/services/core/src:/app/services/api/src:/app/services/ml/src:/app/services/optimizer/src:/app/pipelines/src"

EXPOSE 8000

CMD ["uvicorn", "inveniq_api.main:app", "--host", "0.0.0.0", "--port", "8000"]
