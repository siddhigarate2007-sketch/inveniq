# InvenIQ Environment Configuration Template
ENV=development
LOG_LEVEL=INFO
APP_NAME=InvenIQ
APP_PORT=8000
SECRET_KEY=tbo-inveniq-super-secure-production-ready-jwt-secret-key-32chars

# Database & Cache
POSTGRES_USER=inveniq_user
POSTGRES_PASSWORD=inveniq_secure_pass
POSTGRES_DB=inveniq_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://inveniq_user:inveniq_secure_pass@localhost:5432/inveniq_db

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Object Storage / Lakehouse
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET_NAME=inveniq-artifacts
LAKEHOUSE_PATH=./data/lakehouse
RAW_DATA_PATH=./data/raw

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=inveniq-demand-forecasting

# Optimization Defaults
DEFAULT_BUDGET_INR=50000000
DEFAULT_RISK_APPETITE=BALANCED
DEFAULT_CVAR_ALPHA=0.95
MAX_SOLVER_TIME_SECONDS=60
